# ===================================================================
# .htaccess — danova-ai.com (Hostinger / LiteSpeed)
# IMPORTANTE: se já existir um .htaccess em public_html, NÃO apague o
# antigo — cole este bloco NO TOPO dele e mantenha o restante.
# ===================================================================

# Página inicial: o site (index.html) tem prioridade sobre páginas padrão da Hostinger (index.php/default.php).
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Forçar HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://danova-ai.com%{REQUEST_URI} [L,R=301]

# 2) www -> domínio sem www (uma única versão para o Google)
RewriteCond %{HTTP_HOST} ^www\.danova-ai\.com$ [NC]
RewriteRule ^ https://danova-ai.com%{REQUEST_URI} [L,R=301]

# 3) /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# 4) Cópias duplicadas -> versão oficial (evita conteúdo duplicado no Google)
RewriteRule ^site\.html$ / [L,R=301]
RewriteRule ^DANOVA_Catalisador_v12\.html$ /livro.html [L,R=301]

# 5) Ferramenta interna com chaves de API no código: bloqueada ao público (403).
#    Para reativar, mova-a para uma pasta protegida por senha (hPanel > Segurança >
#    Diretórios protegidos por senha) DEPOIS de trocar as chaves e a senha.
RewriteRule ^buscador\.html$ - [F,L]

# 6) Arquivos internos nunca ficam públicos (403): arquivos ocultos (.env, .git, controle do envio
#    automático…), cópias de pastas, código-fonte e backups. A pasta .well-known continua acessível.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^public_html(/|$) - [F,L]
RewriteRule \.(sql|md|py|ts|sh|bak|old|orig|log|ini|env|yml|yaml|lock|zip|tar|gz|7z)$ - [F,L,NC]
</IfModule>

# Sem listagem de pastas
Options -Indexes

# Compressão (LiteSpeed já faz Brotli; isto cobre fallback)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache do navegador
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/xml "access plus 1 day"
ExpiresByType text/plain "access plus 1 day"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
# HTML sempre revalidado (alterações aparecem na hora)
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
# Arquivos estáticos com cache longo
<FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|svg|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Cabeçalhos de segurança básicos
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# Microfone liberado só para o próprio site (atendente por voz); câmera, localização e pagamento bloqueados.
Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
# HTTPS obrigatório por 1 ano (o navegador nunca tenta a versão sem cadeado)
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# Política de conteúdo básica: ninguém incorpora o site em outro (clickjacking), sem plugins e sem <base> injetado.
Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
Header always unset X-Powered-By
</IfModule>

# Tipos corretos
AddType image/webp .webp
AddType image/avif .avif
AddType application/manifest+json .webmanifest
